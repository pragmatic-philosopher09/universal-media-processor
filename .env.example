# Copy to `.env` (or export in your shell / docker-compose). Every value is optional.

# ---- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Where downloaded / enhanced files live (auto-cleaned after JOB_TTL_MINUTES)
DATA_DIR=./data
JOB_TTL_MINUTES=60
# Enhancement is CPU/GPU heavy; keep this small
MAX_CONCURRENT_JOBS=2
MAX_JOBS_PER_IP=2
# Set to 0 on tiny servers: downloads only, the UI hides the Enhance option
ENHANCEMENT_ENABLED=1
# Refuse to *enhance* clips longer than this (originals still download)
MAX_DURATION_SECONDS=600
# Refuse to *download* videos longer than this (YouTube can be hours long)
MAX_SOURCE_DURATION_SECONDS=1800
# Set to 1 when running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=0
# Comma-separated host allow-list (defaults to Instagram domains only)
# ALLOWED_DOMAINS=instagram.com,instagr.am

# ---- Logins (Instagram stories / most reels; rarely YouTube, TikTok, DeviantArt) ----------
# Per-platform `Cookie:` header strings. Users can still paste their own cookie in the UI
# (unless ALLOW_USER_COOKIES=0). IG_SESSIONID / IG_COOKIES remain as Instagram aliases.
# INSTAGRAM_COOKIES=sessionid=...; ds_user_id=...; csrftoken=...
# YOUTUBE_COOKIES=SID=...; HSID=...; SSID=...; APISID=...; SAPISID=...; LOGIN_INFO=...
# TIKTOK_COOKIES=sessionid=...
# DEVIANTART_COOKIES=auth=...; auth_secure=...
# COOKIES_FILE=/path/to/cookies.txt                       # Netscape export covering any site
# COOKIES_FROM_BROWSER=safari                             # local use: chrome, safari, firefox ...
ALLOW_USER_COOKIES=1
# Automatic browser login: when Instagram demands a login and nothing above is configured, the
# app reads the Instagram session from a browser on the *server's* machine.
#   local  = only for requests coming from that same machine (default; safe for laptops)
#   always = for every request (single-user servers only!)
#   off    = never
AUTO_BROWSER_COOKIES=local
# Which browsers/profiles to try, in order. yt-dlp syntax: BROWSER[+KEYRING][:PROFILE].
# Only the default profile is read unless you name one, e.g. "chrome:Profile 3".
# BROWSER_COOKIE_ORDER=safari,chrome,firefox,edge,brave,chromium,vivaldi,opera

# ---- ffmpeg -----------------------------------------------------------------
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# auto = hardware encoder when one works (videotoolbox / nvenc / qsv), otherwise libx264
VIDEO_ENCODER=auto
X264_PRESET=medium
X264_CRF=18
# Contrast-adaptive sharpening after upscaling (0 = off, 1 = max). 0.3 stays natural.
SHARPEN=0.3
# high = best minterpolate settings (slow), fast = ~2x quicker
FFMPEG_INTERP_QUALITY=high
# Bitrate target for hardware encoders, in bits per pixel per frame (0.08 -> ~40 Mbps at 4K60)
BITS_PER_PIXEL=0.08

# ---- Optional AI engine (RIFE + Real-ESRGAN via ncnn-vulkan, or video2x) ----
# EXPERIMENTAL / UNVERIFIED: tested only against stubs of the real binaries.
# auto = use AI when the binaries are found, ncnn / video2x = force, off = never
AI_ENGINE=auto
# RIFE_BIN=rife-ncnn-vulkan
# REALESRGAN_BIN=realesrgan-ncnn-vulkan
# VIDEO2X_BIN=video2x
# rife-v4* models support arbitrary frame-rate ratios (needed for 25 -> 60 fps)
AI_RIFE_MODEL=rife-v4.6
# realesrgan-x4plus (photo-real, x4 then downscaled) or realesr-animevideov3 (fast, x2/x3/x4)
AI_UPSCALE_MODEL=realesrgan-x4plus
# 0 = auto (4 for x4-only models, otherwise the smallest factor that reaches the target)
AI_UPSCALE_SCALE=0
# Source frames processed per batch; lower = less disk, more model reloads
AI_CHUNK_FRAMES=32
# png (lossless, default) | webp | jpg for intermediate frames
AI_FRAME_FORMAT=png
# AI_GPU_ID=0
# AI_TILE_SIZE=0
# VIDEO2X_RIFE_MODEL=rife-v4.26
# VIDEO2X_REALESRGAN_MODEL=realesr-animevideov3
